# Environment
PYTHONUNBUFFERED=1

# Server
HOST=0.0.0.0
PORT=8000

# Scraping defaults
DEFAULT_MODE=auto
DEFAULT_TIMEOUT=30
DEFAULT_FORMAT=json

# Proxy (optional - single proxy or path to proxy list file)
# PROXY=http://user:pass@proxy:port
# PROXY_LIST=proxies.txt

# Output
OUTPUT_DIR=output

# Scheduler
ENABLE_SCHEDULER=true
